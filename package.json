{
  "name": "apps",
  "private": true,
  "scripts": {
    "check": "biome check",
    "check:fix": "biome check --fix",
    "test:all": "pnpm -r test",
    "test:all:cov": "pnpm -r test:coverage",
    "test:portal": "pnpm -r --filter=portal test",
    "typecheck:portal": "pnpm -r --filter=portal typecheck",
    "build:portal": "pnpm -r --filter=portal build",
    "build": "pnpm -w --filter=portal build",
    "dev:manager": "pnpm -r --filter=manager dev",
    "test:manager": "pnpm -r --filter=manager test"
  },
  "packageManager": "pnpm@10.1.0+sha512.c89847b0667ddab50396bbbd008a2a43cf3b581efd59cf5d9aa8923ea1fb4b8106c041d540d08acb095037594d73ebc51e1ec89ee40c88b30b8a66c0fae0ac1b",
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "knip": "^5.63.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "utf-8-validate",
      "esbuild",
      "@swc/core",
      "protobufjs",
      "keccak"
    ],
    "patchedDependencies": {
      "xstate": "patches/xstate.patch"
    }
  }
}