# Shared secret used only between the API Worker and this service.
GENERATOR_AUTH_TOKEN=

# Bucket-scoped staging R2 credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ensv2-commemorative-nft-staging
R2_PUBLIC_ORIGIN=https://pub-43406b099825402eb42ecfb3494a902b.r2.dev

# Public URLs embedded in generated metadata. NFT_EXTERNAL_ORIGIN is used
# exactly as external_url; no token ID is appended.
NFT_PUBLIC_ASSET_ORIGIN=https://app-api.ens.dev/v1/commemorative-nft
NFT_EXTERNAL_ORIGIN=https://app.ens.dev/migration/nft

# Renderer release pinned by the Worker and generator.
RENDERER_ORIGIN=https://ens-renderer.pages.dev
RENDERER_REVISION=sha256:1571ef297695dea0e1b816bb27dc5302209124424cb224e8effdd0ac7a7a3102

# NVIDIA is required for staging. The EC2 mode selects regular Chromium and the
# harness-derived Linux Vulkan flags. Software mode also requires a non-staging
# R2_BUCKET_NAME so local output cannot poison immutable staging keys.
CHROMIUM_GRAPHICS_MODE=ec2-nvidia
CHROMIUM_EXECUTABLE_PATH=
# Additional reviewed flags only; known conflicts with the Vulkan profile are
# rejected and runtime readiness remains fail-closed.
CHROMIUM_EXTRA_ARGS_JSON=[]
CAPTURE_TIMEOUT_MS=390000
PORT=3000
