{
  "name": "api-worker",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/worker.ts",
  "exports": {
    "./hc": {
      "types": "./dist/src/hc.d.ts",
      "default": "./dist/src/hc.js"
    }
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:vite\" \"pnpm dev:tsc\" --names \"vite,tsc\" --prefix-colors \"cyan,yellow\" --kill-others-on-fail --restart-tries 3 --restart-after 2000",
    "dev:vite": "vite dev",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:vite": "vite build",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build": "pnpm build:vite && pnpm build:tsc",
    "deploy": "pnpm build:vite && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings worker-configuration.gen.d.ts",
    "test": "vitest run",
    "test:db": "RUN_REAL_DB_TESTS=1 vitest run src/queues/event-ingestion.db.test.ts src/queues/delivery.db.test.ts src/services/email/challenges.db.test.ts src/services/telegram/attempts.db.test.ts",
    "lint": "biome check"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@ens-apps/config": "workspace:*",
    "@ens-apps/indexer": "workspace:*",
    "@ens-apps/shared-schema": "workspace:*",
    "@ens-apps/utils": "workspace:*",
    "@ensdomains/ensjs": "catalog:",
    "@hono/valibot-validator": "^0.5.3",
    "@neondatabase/serverless": "^1.2.0",
    "@react-email/components": "^1.0.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "catalog:",
    "lucide": "^0.542.0",
    "neverthrow": "^8.2.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-pattern": "^5.9.2",
    "uuid": "^13.0.2",
    "valibot": "^1.5.0",
    "viem": "catalog:",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@grammyjs/types": "^3.28.0",
    "@sendgrid/helpers": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "imports": {
    "#*": "./src/*"
  }
}
