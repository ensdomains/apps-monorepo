WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB="postgresql://postgres:postgres@localhost/postgres"
JWT_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
SENDGRID_API_KEY=""
EMAIL_FROM_ADDRESS=""
# Server wallet for Crossmint fulfilment (and the faucet). In Zodiac Roles mode
# this key is only a role member paying gas — the Safe below holds the funds.
ETH_PRIVATE_KEY=""
# Zodiac Roles hardening. Set BOTH or NEITHER — partial config fails loudly.
# Setup runbook: docs/zodiac-roles.md + scripts/setup-zodiac-roles.ts.
REGISTRAR_SAFE_ADDRESS=""
REGISTRAR_ROLES_MODULE_ADDRESS=""
# Local/dev only: opt into signing straight from ETH_PRIVATE_KEY when the Role
# vars above are unset. Omit in any real deployment — missing Role vars then
# fail closed instead of degrading to an unscoped hot key.
ALLOW_DIRECT_EOA_SIGNER="1"
