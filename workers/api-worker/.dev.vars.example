SEPOLIA_RPC_URL="https://lb.drpc.live/sepolia/<your-drpc-key>"
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB="postgresql://postgres:postgres@localhost/postgres"
JWT_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
SENDGRID_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Rhinestone gas-sponsorship JWT issuer (FET-3334).
#
# The ONLY value that must be set is the signing key. Everything else has a
# Sepolia-launch default baked into the code (see config.ts IDENTITY_DEFAULTS /
# predicate.ts DEFAULT_SPONSORSHIP_CHAIN_IDS) and only needs setting to override.
#
# RHINESTONE_JWT_SIGNING_KEYS — REQUIRED. JSON array of { keyId, privateKey }
# where privateKey is a JWK (EC P-256 -> ES256). A single key selects itself;
# hold several + set RHINESTONE_JWT_ACTIVE_KEY_ID for zero-downtime kid rotation.
RHINESTONE_JWT_SIGNING_KEYS="[]"
#
# Optional overrides (defaults in code; uncomment only to change them):
# RHINESTONE_JWT_ACTIVE_KEY_ID=""        # only needed with multiple keys
# RHINESTONE_INTEGRATOR_ID=""            # default: app
# RHINESTONE_PROJECT_ID=""               # default: cmgk24o77001v3j0tkscm3a65
# RHINESTONE_APP_ID=""                   # default: ens-manager-sepolia
# RHINESTONE_JWT_AUDIENCE=""             # default: rhinestone-api (SDK)
# RHINESTONE_SPONSORSHIP_CHAIN_IDS=""    # default: 11155111 (Sepolia only)
