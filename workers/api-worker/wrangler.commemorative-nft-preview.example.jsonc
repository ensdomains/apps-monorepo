{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "app-api-worker-commemorative-nft-preview-REPLACE_ME",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "COMMEMORATIVE_NFT_BUCKET",
      "bucket_name": "ensv2-commemorative-nft-staging"
    }
  ],

  "workflows": [
    {
      "binding": "COMMEMORATIVE_NFT_GENERATION",
      "name": "commemorative-nft-generation-preview-REPLACE_ME",
      "class_name": "CommemorativeNftGenerationWorkflow"
    }
  ],

  "vars": {
    "CHAIN": "sepolia",
    "BASE_URL": "https://app-api-worker-commemorative-nft-preview-REPLACE_ME.REPLACE_WITH_ACCOUNT_SUBDOMAIN.workers.dev",
    "COMMEMORATIVE_NFT_CONTRACT_ADDRESS": "0xe49A9D706FCD82AA575496352B5633F80fBBC449",
    "COMMEMORATIVE_NFT_GENERATOR_ORIGIN": "",
    "COMMEMORATIVE_NFT_RENDERER_REVISION": "sha256:1571ef297695dea0e1b816bb27dc5302209124424cb224e8effdd0ac7a7a3102",
    "MANAGER_APP_URL": "http://localhost:3000"
  }
}
