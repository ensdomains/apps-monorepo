{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "app-api-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-14",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "85a14d25fa4a41a3a7123bcd5093c09a"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "EVENT_INGESTION_QUEUE",
        "queue": "app-api-worker-event-ingestion"
      },
      {
        "binding": "TELEGRAM_QUEUE",
        "queue": "app-api-worker-telegram-delivery"
      },
      {
        "binding": "EMAIL_QUEUE",
        "queue": "app-api-worker-email-delivery"
      },
      {
        "binding": "PUSH_QUEUE",
        "queue": "app-api-worker-push-delivery"
      },
      {
        "binding": "DLQ",
        "queue": "app-api-worker-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "app-api-worker-telegram-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "app-api-worker-dlq"
      },
      {
        "queue": "app-api-worker-email-delivery",
        "max_batch_size": 50,
        "max_batch_timeout": 3,
        "max_retries": 3,
        "dead_letter_queue": "app-api-worker-dlq"
      },
      {
        "queue": "app-api-worker-push-delivery",
        "max_batch_size": 50,
        "max_batch_timeout": 3,
        "max_retries": 3,
        "dead_letter_queue": "app-api-worker-dlq"
      },
      {
        "queue": "app-api-worker-event-ingestion",
        "max_batch_size": 50,
        "max_batch_timeout": 3,
        "max_retries": 3
      },
      {
        "queue": "app-api-worker-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 0
      }
    ]
  },

  "triggers": {
    "crons": ["0 */1 * * *", "17 */3 * * *"]
  },

  // Secret names only. Values are provisioned separately on each Worker.
  "secrets": {
    "required": [
      "DATABASE_URL",
      "JWT_SECRET",
      "POSTHOG_PERSONAL_API_KEY",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "SENDGRID_API_KEY",
      "SENDGRID_WEBHOOK_VERIFICATION_KEY",
      "VAPID_PRIVATE_KEY",
      "SEPOLIA_RPC_URL",
      "ETH_PRIVATE_KEY"
    ]
  },

  // Mainnet deployment smoke testing: /health works without infrastructure.
  // Full API readiness is incomplete; see DEPLOYMENT_READINESS.md.
  "env": {
    "mainnet": {
      "name": "app-api-worker-mainnet",
      "workers_dev": true,
      "preview_urls": false,
      // Non-inheritable bindings must be provisioned independently. Never use
      // the default environment's KV, queues, provider settings or secrets.
      "vars": {
        "CHAIN": "mainnet",
        "EMAIL_FROM_ADDRESS": "noreply@notifications.ens.domains",
        "VAPID_SUBJECT": "mailto:noreply@notifications.ens.domains",
        "VAPID_PUBLIC_KEY": "BHv_hmbABVX2slygTBmWVdWGicQCpKGE-tlrOWBgSyWlHdbcFB7An3kRT-1gVnUce6_yr0qteoISC5CPWHunejU"
      },
      // Non-inheritable: declare the shared requirements again, without the
      // Sepolia RPC or faucet key. This does not provision production values.
      "secrets": {
        "required": [
          "DATABASE_URL",
          "JWT_SECRET",
          "POSTHOG_PERSONAL_API_KEY",
          "TELEGRAM_BOT_TOKEN",
          "TELEGRAM_WEBHOOK_SECRET",
          "SENDGRID_API_KEY",
          "SENDGRID_WEBHOOK_VERIFICATION_KEY",
          "VAPID_PRIVATE_KEY"
        ]
      },
      // Create a separate mainnet namespace and add its real id here before deployment.
      // Without an id, Wrangler can auto-provision it during a future deployment.
      "kv_namespaces": [{ "binding": "KV" }],
      "queues": {
        "producers": [
          {
            "binding": "EVENT_INGESTION_QUEUE",
            "queue": "app-api-worker-mainnet-event-ingestion"
          },
          {
            "binding": "TELEGRAM_QUEUE",
            "queue": "app-api-worker-mainnet-telegram-delivery"
          },
          {
            "binding": "EMAIL_QUEUE",
            "queue": "app-api-worker-mainnet-email-delivery"
          },
          {
            "binding": "PUSH_QUEUE",
            "queue": "app-api-worker-mainnet-push-delivery"
          },
          {
            "binding": "DLQ",
            "queue": "app-api-worker-mainnet-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "app-api-worker-mainnet-telegram-delivery",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "app-api-worker-mainnet-dlq"
          },
          {
            "queue": "app-api-worker-mainnet-email-delivery",
            "max_batch_size": 50,
            "max_batch_timeout": 3,
            "max_retries": 3,
            "dead_letter_queue": "app-api-worker-mainnet-dlq"
          },
          {
            "queue": "app-api-worker-mainnet-push-delivery",
            "max_batch_size": 50,
            "max_batch_timeout": 3,
            "max_retries": 3,
            "dead_letter_queue": "app-api-worker-mainnet-dlq"
          },
          {
            "queue": "app-api-worker-mainnet-event-ingestion",
            "max_batch_size": 50,
            "max_batch_timeout": 3,
            "max_retries": 3
          },
          {
            "queue": "app-api-worker-mainnet-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 0
          }
        ]
      },
      "triggers": {
        "crons": ["0 */1 * * *", "17 */3 * * *"]
      }
    }
  },

  "vars": {
    "CHAIN": "sepolia",
    "BASE_URL": "https://sepolia.app-api.ens.domains",
    "EMAIL_FROM_ADDRESS": "noreply@notifications.ens.domains",
    "MANAGER_APP_URL": "https://sepolia.app.ens.domains",
    "POSTHOG": {
      "host": "https://eu.posthog.com",
      "unique_searches_endpoint": "/api/projects/109100/endpoints/unique_name_searches_last_30d/run"
    },
    "VAPID_SUBJECT": "mailto:noreply@notifications.ens.domains",
    "VAPID_PUBLIC_KEY": "BOBjtfgZPtGSJtajVkh4T1Ceswos_aRXYlD4Mq8aXEa4sc_0lkrwKzUhnUIgCt22_cAEYSr0wZlhCiWPsFXyRGs",
    "TELEGRAM": {
      "ALERT_CHAT_ID": "-5381499765"
    },
    "SENDGRID_BROADCAST_LIST_ID": ""
  }
}
