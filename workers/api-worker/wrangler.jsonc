{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-api-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-14",
  "compatibility_flags": ["nodejs_compat"],

  "hyperdrive": [
    {
      "binding": "DB",
      "id": "NONE",
      "localConnectionString": "postgresql://postgres:postgres@localhost/postgres"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4f44782c9c28436c9af279f46298fb94"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "TELEGRAM_QUEUE",
        "queue": "api-worker-telegram-delivery"
      },
      {
        "binding": "EMAIL_QUEUE",
        "queue": "api-worker-email-delivery"
      }
    ],
    "consumers": [
      {
        "queue": "api-worker-telegram-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "api-worker-telegram-delivery-dlq"
      },
      {
        "queue": "api-worker-email-delivery",
        "max_batch_size": 50,
        "max_batch_timeout": 3,
        "max_retries": 3,
        "dead_letter_queue": "api-worker-email-delivery-dlq"
      }
    ]
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "vars": {
    "CHAIN": "mainnet",
    "BASE_URL": "https://notifications.ens.domains",
    "EMAIL_FROM_ADDRESS": "notifications@ens.domains",
    "MANAGER_APP_URL": "http://localhost:3000"
  }
}
