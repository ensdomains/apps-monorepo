{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "app-api-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-14",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "85a14d25fa4a41a3a7123bcd5093c09a"
    }
  ],

  "d1_databases": [
    {
      "binding": "CROSSMINT_DB",
      "database_name": "app-api-worker-crossmint",
      "database_id": "8d96fa19-5ff5-4833-8b47-a495d0b21a0b",
      "migrations_dir": "d1-migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "EVENT_INGESTION_QUEUE",
        "queue": "app-api-worker-event-ingestion"
      },
      {
        "binding": "TELEGRAM_QUEUE",
        "queue": "app-api-worker-telegram-delivery"
      },
      {
        "binding": "EMAIL_QUEUE",
        "queue": "app-api-worker-email-delivery"
      },
      {
        "binding": "PUSH_QUEUE",
        "queue": "app-api-worker-push-delivery"
      },
      {
        "binding": "REGISTRATION_QUEUE",
        "queue": "app-api-worker-registration"
      },
      {
        "binding": "DLQ",
        "queue": "app-api-worker-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "app-api-worker-registration",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "app-api-worker-dlq"
      },
      {
        "queue": "app-api-worker-telegram-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "app-api-worker-dlq"
      },
      {
        "queue": "app-api-worker-email-delivery",
        "max_batch_size": 50,
        "max_batch_timeout": 3,
        "max_retries": 3,
        "dead_letter_queue": "app-api-worker-dlq"
      },
      {
        "queue": "app-api-worker-push-delivery",
        "max_batch_size": 50,
        "max_batch_timeout": 3,
        "max_retries": 3,
        "dead_letter_queue": "app-api-worker-dlq"
      },
      {
        "queue": "app-api-worker-event-ingestion",
        "max_batch_size": 50,
        "max_batch_timeout": 3,
        "max_retries": 3
      },
      {
        "queue": "app-api-worker-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 0
      }
    ]
  },

  "triggers": {
    "crons": ["0 */1 * * *"]
  },

  "vars": {
    "CHAIN": "sepolia",
    // Zodiac Roles v2 fulfilment config (public addresses, not secrets — see
    // docs/zodiac-roles.md). The treasury Safe is the payer; the worker EOA
    // (ETH_PRIVATE_KEY) must be a member of the `ens-crossmint-registrar`
    // role on the modifier. Both set => Roles mode; both absent => the
    // fulfilment signer fails closed (no silent direct-EOA signing).
    "REGISTRAR_SAFE_ADDRESS": "0x6A15F8314393Fa816D2b8A9437fBDFd9cca9293C",
    "REGISTRAR_ROLES_MODULE_ADDRESS": "0x250f3a370fA3Bb0704B9998B4F0A33057b248EbD",
    "BASE_URL": "https://app-api.ens.dev",
    "EMAIL_FROM_ADDRESS": "noreply@ens.dev",
    "ENS_INDEXER_GRAPHQL_URL": "https://graphql.ens.dev/",
    "MANAGER_APP_URL": "https://app.ens.dev",
    "VAPID_SUBJECT": "mailto:notifications@ens.domains",
    "VAPID_PUBLIC_KEY": "BOBjtfgZPtGSJtajVkh4T1Ceswos_aRXYlD4Mq8aXEa4sc_0lkrwKzUhnUIgCt22_cAEYSr0wZlhCiWPsFXyRGs",
    "SENDGRID_BROADCAST_LIST_ID": "",
    "SENDGRID_TEMPLATE_IDS": {
      "name-expiry": "d-fb5409b2dc1e44f6919cd648eb983adf",
      "name-transferred": "d-f1db08f6dcc54d92a055e8637327ac2a"
    }
  }
}
