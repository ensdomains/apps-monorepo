{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-14",
  "compatibility_flags": ["nodejs_compat"],

  "hyperdrive": [
    {
      "binding": "DB",
      "id": "NONE",
      "localConnectionString": "postgresql://postgres:postgres@localhost/postgres"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4f44782c9c28436c9af279f46298fb94"
    }
  ],

  "vars": {
    "CHAIN": "mainnet",
    "BASE_URL": "https://notifications.ens.domains"
  }
}
