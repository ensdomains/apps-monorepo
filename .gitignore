node_modules
coverage
# ...except the E2E coverage ledger, which is source, not a generated report:
# it is the committed state the E2E goal resumes from (e2e/docs/e2e-goal.md).
!e2e/coverage/
.claude/
dist
**/.DS_Store
package-lock.json
.worktrees/
*.workspace
.mcp.json
.dev.vars
.pnpm-store/
opencode.json
e2e/test-results/*
# Generated by `pnpm e2e:portal:review` — videos/traces for human review, never committed
e2e/playwright-report/
.security-audit/
# E2E infra secrets (Linear OAuth for the dqa service, etc.)
e2e/infra/.env
*.tsbuildinfo

# Local credential scratch. `.secrets` holds real API keys (Para, PostHog,
# Gemini) and was tracked by nothing but also ignored by nothing, so a single
# `git add -A` at the repo root would have committed it.
.secrets
# Zero-byte files left by mistyped shell redirects (`> apps@`, `> pnpm`).
/apps@
/pnpm
