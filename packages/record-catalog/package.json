{
  "name": "@ens-apps/record-catalog",
  "version": "1.0.0",
  "description": "Shared ENS text and address record metadata and search",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./address": "./src/address.ts",
    "./address-assets/*": "./src/address-assets/*",
    "./address-icons": "./src/address-icons.tsx",
    "./social-contact-icons": "./src/social-contact-icons.tsx",
    "./text": "./src/text.ts",
    "./text-icons": "./src/text-icons.tsx"
  },
  "scripts": {
