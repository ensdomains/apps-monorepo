# WalletConnect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Pimlico API Key for Smart Account functionality (get from https://www.pimlico.io)
VITE_PIMLICO_API_KEY=your_pimlico_api_key_here

# Rhinestone API Key (get from https://www.rhinestone.wtf)
# This is required for Rhinestone smart account features
VITE_RHINESTONE_API_KEY=your_rhinestone_api_key_here

# Optional: Paymaster URL for gasless transactions
# VITE_PAYMASTER_URL=https://api.pimlico.io/v2/sepolia/rpc?apikey=your_api_key

# Optional: Custom Bundler URL (defaults to Pimlico)
# VITE_BUNDLER_URL=https://api.pimlico.io/v2/sepolia/rpc?apikey=your_api_key