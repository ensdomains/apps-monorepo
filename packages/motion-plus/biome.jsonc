{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "extends": "//",
  "files": {
    // Vendored third-party source (Motion+), not ours to fix. Excluding it
    // leaves this package with nothing to check, which Biome treats as an
    // error — hence `--no-errors-on-unmatched` on the package's lint script.
    "includes": ["!./src"]
  },
  "root": false
}
