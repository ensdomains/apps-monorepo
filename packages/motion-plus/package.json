{
    "name": "motion-plus",
    "version": "2.10.0",
    "private": true,
    "description": "A collection of Motion functions and components, exclusive to Motion+ members.",
    "main": "src/index.js",
    "module": "src/index.mjs",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.mjs"
        },
        "./react": {
            "types": "./src/react-entry.d.ts",
            "default": "./src/react-entry.mjs"
        },
        "./animate-activity": {
            "types": "./src/animate-activity.d.ts",
            "default": "./src/animate-activity.mjs"
        },
        "./animate-layout": {
            "types": "./src/animate-layout.d.ts",
            "default": "./src/animate-layout.mjs"
        },
        "./animate-view": {
            "types": "./src/animate-view.d.ts",
            "default": "./src/animate-view.mjs"
        }
    },
    "author": {
        "name": "Matt Perry",
        "url": "https://motion.dev"
    },
    "license": "MIT",
    "dependencies": {
        "motion": "^12.25.0",
        "motion-dom": "^12.25.0",
        "motion-plus-dom": "^2.9.0",
        "motion-utils": "^12.23.6"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    }
}
