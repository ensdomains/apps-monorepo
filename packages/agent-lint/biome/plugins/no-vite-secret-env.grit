engine biome(1.0)
language js(typescript, jsx)

// Rule: tanstack-start.md: a secret stays server-side. A VITE_ variable ships to the
// browser. Public, publishable, site and anonymous keys are meant to.

`import.meta.env.$name` as $bad where {
  $name <: r"VITE_.*(?:API_KEY|SECRET|PRIVATE_KEY|PASSWORD|ACCESS_TOKEN|AUTH_TOKEN|_TOKEN).*",
  $name <: not r".*(?:PUBLIC|PUBLISHABLE|SITE_KEY|ANON).*",
  register_diagnostic(span=$bad, message="[no-vite-secret-env] A VITE_ variable is shipped to the browser; keep secrets server-side.", severity="error")
}
