{
  "name": "@ens-apps/agent-lint",
  "version": "1.0.0",
  "license": "MIT",
  "description": "A stricter check on the lines AI agents add or change",
  "type": "module",
  "private": true,
  "scripts": {
    "agent-lint": "node --max-old-space-size=8192 --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "docs:rules": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/writeDocs.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint-react/eslint-plugin": "^5.0.0",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/rule-tester": "^8.71.2",
    "@typescript-eslint/utils": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "fast-check": "^4.0.0",
    "neverthrow": "^8.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "catalog:"
  }
}
