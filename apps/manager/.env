# HCA smart-account path works on fix-hca-rhinestone (Rhinestone SDK 1.7.0
# native HCA + ENS owner; Warp-sponsored, owner-signed Intents). Keep this
# `false` so the smart-account machine runs — this is what resolves the
# Para-embedded owner address and triggers auto-funding. Set to `true` only
# to bypass Rhinestone entirely for local EOA-only debugging (external wagmi
# wallets only — Para-embedded has no wagmi client, so it won't fund/sign).
VITE_FF_USE_EOA=false

# DQA overlay is QA/preview-only and MUST NOT be enabled from this committed
# .env (Vite reads it in production builds too). Enable it for local dev in
# apps/manager/.env.local (gitignored); PR previews inject it via CI. See
# e2e/docs/dqa-overlay.md.
# E2E local infra overrides (not committed to CI — kept in working tree)
VITE_SEPOLIA_RPC_URL=/rpc
VITE_SEPOLIA_RPC_URL_SERVER=http://127.0.0.1:8545
VITE_PAYMASTER_URL=/paymaster
VITE_FF_RHINESTONE_SESSIONS=true

VITE_RHINESTONE_ENDPOINT_URL=/orchestrator
VITE_RHINESTONE_USE_DEV_CONTRACTS=true
VITE_RHINESTONE_CUSTOM_RPC_URLS={"11155111":"http://127.0.0.1:8545"}
VITE_INDEXER_GRAPHQL_URL=http://127.0.0.1:5655/graphql
ANVIL_PARA_PRIVATE_KEY=0x4d1cf5e322e2a7dbfc9e3eccde100ed93167879de7449d18872911ed3a957a81
VITE_USE_MOCK_WALLET=false

VITE_TIME_TRAVEL=1
VITE_TIME_TRAVEL_RPC=/rpc
VITE_MIGRATION_TOOL=1
VITE_MIGRATION_TOOL_RPC=/rpc

# Base URL the portal links to for the ENSv2 migration flow (manager app).
# Falls back to https://app.ens.dev when unset.
VITE_MANAGER_APP_URL=http://localhost:3000
