VITE_FF_USE_WARP_INFRA=true
# HCA smart-account path works on fix-hca-rhinestone (Rhinestone SDK 1.7.0
# native HCA + ENS owner; Warp-sponsored, owner-signed Intents). Keep this
# `false` so the smart-account machine runs — this is what resolves the
# Para-embedded owner address and triggers auto-funding. Set to `true` only
# to bypass Rhinestone entirely for local EOA-only debugging (external wagmi
# wallets only — Para-embedded has no wagmi client, so it won't fund/sign).
VITE_FF_USE_EOA=false

# Wallet vendor (build time): false → RainbowKit (default, external EOA wallets);
# true → Privy (social / email login). A Vite alias bundles only the selected
# vendor's stack — a per-deployment choice, not a runtime toggle. Requires
# VITE_PRIVY_APP_ID when true.
VITE_FF_USE_PRIVY=false

# Privy app id (social login: Google + X). PUBLIC client identifier — it ships
# in the browser bundle; access is gated by the allowed-origins allowlist in the
# Privy dashboard, NOT by hiding this value. The real secrets (Privy app secret,
# Google OAuth client secret) live in the Privy dashboard, never here. If unset,
# the app still boots with auth disabled.
VITE_PRIVY_APP_ID=cmpznqsw500g80cl5bjzcke6e
