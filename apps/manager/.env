# Committed public settings. Sepolia is the default; mainnet uses --mode mainnet.
# Personal overrides belong in .env.local or .env.mainnet.local. Never add secrets here.

VITE_ALCHEMY_NFT_API_KEY=zC-BDVwZsnpd835sCZAQp

VITE_FF_TEMP_PREMIUM_NAME_STATS=true

VITE_PUBLIC_POSTHOG_KEY=phc_hDnz5mVAqDQTJ23yNPW3viwJMi3bp2YLuxsAuafisIR
VITE_PUBLIC_POSTHOG_HOST=https://edge.ens.domains

# Use the smart-account flow. Override locally for EOA-only debugging.
VITE_FF_USE_EOA=false

# Default upload service. The mainnet build mode overrides it in .env.mainnet.
VITE_AVATAR_UPLOAD_URL=https://avatar-upload-staging.ens-cf.workers.dev

# DQA overlay is QA/preview-only and MUST NOT be enabled from this committed
# .env (Vite reads it in production builds too). Enable it for local dev in
# apps/manager/.env.local (gitignored); PR previews inject it via CI. See
# e2e/docs/dqa-overlay.md.

# Target network: mainnet | sepolia. Required; the build fails if unset.
VITE_ENS_NETWORK=sepolia
