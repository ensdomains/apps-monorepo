# Rhinestone orchestrator endpoint. In local dev this points at the Vite proxy
# (`/orchestrator` → mockestrator on :3007, see vite.config.ts), so no extra
# service is needed. In production it is the same-origin server route
# `/api/orchestrator`, which injects the API key server-side (no key in the
# client bundle). Leave VITE_RHINESTONE_API_KEY unset.
VITE_RHINESTONE_ENDPOINT_URL=/orchestrator
VITE_ALCHEMY_NFT_API_KEY=zC-BDVwZsnpd835sCZAQp

#VITE_API_URL=https://app-api-worker.ens-cf.workers.dev
#VITE_API_URL=https://app-api.ens.dev/
# TEMPORARY: point the manager (incl. preview builds) at the web-414 api-worker
# preview (a `wrangler versions upload --preview-alias web-414-eth-drip` of
# app-api-worker, so it inherits prod secrets) to exercise the migration-gas
# ETH drip end-to-end. Restore the prod URL above before merging.
VITE_API_URL=https://web-414-eth-drip-app-api-worker.ens-cf.workers.dev/
VITE_TELEGRAM_BOT_ID=8430077778
VITE_FF_DISCOUNTS_APPLIED=false
VITE_FF_SKIP_NOTIFICATION_SETTINGS=false
VITE_FF_LANGUAGE_SELECTOR=false
VITE_FF_MIGRATION=true
VITE_FF_PROFILE_EDIT_NEW=true
VITE_FF_PROFILE_VIEW_NEW=false

VITE_PUBLIC_POSTHOG_KEY=phc_hDnz5mVAqDQTJ23yNPW3viwJMi3bp2YLuxsAuafisIR
VITE_PUBLIC_POSTHOG_HOST=https://jakob.ens.domains

VITE_FF_USE_WARP_INFRA=true
# HCA smart-account path works on fix-hca-rhinestone (Rhinestone SDK 1.7.0
# native HCA + ENS owner; Warp-sponsored, owner-signed Intents). Keep this
# `false` so the smart-account machine runs — this is what resolves the
# Para-embedded owner address and triggers auto-funding. Set to `true` only
# to bypass Rhinestone entirely for local EOA-only debugging (external wagmi
# wallets only — Para-embedded has no wagmi client, so it won't fund/sign).
VITE_FF_USE_EOA=false
