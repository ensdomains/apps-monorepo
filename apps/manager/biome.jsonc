{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "functions": ["cn", "cva", "clsx"]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "./**",

      "!**/node_modules/**",
      "!**/public/**",

      // Generated files
      "!**/*.gen.ts",
      "!**/*.gen.d.ts",

      // Build & Temp files
      "!**/.tanstack/**",
      "!**/.output/**",
      "!**/.nitro/**",
      "!**/.wrangler/**"
    ]
  }
}
