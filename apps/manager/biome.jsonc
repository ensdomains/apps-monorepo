{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "extends": "//",
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "files": {
    "includes": [
      "./**",
      "!**/*.gen.ts",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/public/**"
    ]
  }
}
