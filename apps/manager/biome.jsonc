{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "complexity": {
        "noUselessFragments": "error",
        "noForEach": "warn"
      },
      "correctness": {
        "noUnusedImports": {
          "fix": "safe",
          "level": "error"
        },
        "noUnusedVariables": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": {
            "functions": ["cn", "cva", "clsx"]
          }
        }
      },
      "style": {
        "noUselessElse": "error",
        "noNegationElse": "error",
        "noUnusedTemplateLiteral": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "./**",

      "!**/node_modules",
      "!**/public",

      // Generated files
      "!**/*.gen.ts",
      "!**/*.gen.d.ts",

      // Build & Temp files
      "!**/.tanstack",
      "!!**/.output",
      "!!**/.nitro",
      "!!**/.wrangler"
    ]
  }
}
