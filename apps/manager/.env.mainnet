# Public overrides, merged on top of .env by Vite.
CLOUDFLARE_ENV=mainnet
VITE_ENS_NETWORK=mainnet

# Do not inherit the staging bot or staging-only demand statistics.
# Set a mainnet Telegram bot ID once provisioned (or in .env.mainnet.local).
VITE_TELEGRAM_BOT_ID=
VITE_FF_TEMP_PREMIUM_NAME_STATS=false

# Manager requires a mainnet Bigname service. The build deliberately fails
# until NETWORKS.mainnet.bignameApi is configured or this override is supplied.
# VITE_BIGNAME_API_URL=https://<mainnet-bigname-host>
