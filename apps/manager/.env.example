VITE_RHINESTONE_API_KEY=

# Temp premium banner: favorite/search demand stats.
VITE_FF_TEMP_PREMIUM_NAME_STATS=false
# When `true`, force the transaction manager to use plain EOA signing only
# (no Rhinestone smart account) — every tx is signed and paid for by the EOA.
# Keep this `false` in production: the HCA + Warp smart-account flow is the
# product path (gas-sponsored Intents; the payment approval is a gasless
# EIP-2612 permit, so the EOA never sends a transaction). Set `true` only for
# local EOA-only debugging on forks without bundler/relayer infrastructure.
VITE_FF_USE_EOA=false

# NFT UI and marketing copy require both PostHog `migration` and
# `migration-nft` flags plus published eligibility for the current owner.
# ENSv2 commemorative NFT assets are resolved as token/<decimal-token-id>.json
# and token/<decimal-token-id>/image.webp.
VITE_COMMEMORATIVE_NFT_ASSET_ORIGIN=https://v2.nft-assets.ens.domains
# Public browser renderer, using the tokenId query parameter.
VITE_COMMEMORATIVE_NFT_RENDERER_ORIGIN=https://v2.nft.ens.domains
# Backend API base URL — used by backendClient (wallet auto-fund, auth, etc.)
VITE_API_URL=https://sepolia.app-api.ens.domains
# Dev-only manual time travel (grace-period / temp-premium testing). Set to 1
# to enable the floating Time Travel panel + an Anvil-tracking browser clock.
# Requires the local E2E stack. See e2e/docs/manual-time-travel.md.
# VITE_TIME_TRAVEL=1
# VITE_TIME_TRAVEL_RPC=/rpc

# Developer/debug features (/debug/* routes, apiBaseUrlOverride, debug mock
# profile). Enabled automatically in `vite dev`. For preview/production-mode
# builds set to `true` (see `build:dqa`). NEVER set this in a production/mainnet
# deploy.
# VITE_ENABLE_DEBUG_FEATURES=true

# QA-only DQA overlay (design review: pinned comments, live cursors, Linear
# push). Set to 1 to inject the overlay from a running @ens-apps/dqa-server
# (part of the E2E stack: pnpm --filter @ens-apps/e2e infra:up). Unlike
# VITE_TIME_TRAVEL this also works in QA/PR-preview *builds* — NEVER set it in
# a production deploy. See e2e/docs/dqa-overlay.md.
# VITE_DQA=1
# VITE_DQA_URL=http://localhost:4000
# VITE_DQA_LINEAR_ISSUE=ENG-123

# Test-only mock wallet. Set to `true` to register wagmi's `mock` connector and
# auto-connect it on load, so automated browsers (Playwright / agents) sign
# transactions with no popup. The mock connector forwards signing to the
# connected chain's default RPC, so point VITE_SEPOLIA_RPC_URL at a local node
# (Anvil/Hardhat) with the account unlocked. NEVER set in production.
#
# NOTE: registration/renewal gate on the Rhinestone smart account being
# initialized, which needs relayer/bundler infra the mock setup doesn't provide
# (the CTA stays "Connect to register" even though the EOA is connected). To
# register prompt-free with the mock wallet you MUST also enable EOA-only mode
# below (VITE_FF_USE_EOA=true) — every tx is then signed by the EOA and
# forwarded by the mock connector to your local node.
# VITE_USE_MOCK_WALLET=true
# VITE_FF_USE_EOA=true
# Optional: override the mock account (defaults to the `test … junk` account 0).
# VITE_MOCK_ACCOUNT=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Target network: mainnet | sepolia. Required; the build fails if unset.
VITE_ENS_NETWORK=sepolia

# bigname API. Unset reads the network profile; set it for a mock or preview.
# VITE_BIGNAME_API_URL=
