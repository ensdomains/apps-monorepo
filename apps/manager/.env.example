# REMOVE_BEFORE_GRACE_PR: delete this block (grace-period simulation for local testing only).
# Dev only: force grace-period UI as if names expired 12d ago (requires dev server restart).
VITE_FF_SIMULATE_GRACE_PERIOD=false

VITE_FF_RHINESTONE_SESSIONS=false
VITE_FF_USE_WARP_INFRA=false
# When `true`, force the transaction manager to use plain EOA signing only
# (no Rhinestone / Pimlico / ZeroDev). Smart-session prompts are hidden.
VITE_FF_USE_EOA=false
# Backend API base URL — used by backendClient (wallet auto-fund, auth, etc.)
VITE_API_URL=https://ensjs-v2-app-api-worker.ens-cf.workers.dev
