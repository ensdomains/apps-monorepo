VITE_FF_USE_WARP_INFRA=false
VITE_FF_PROFILE_EDIT_NEW=false
# When `true`, force the transaction manager to use plain EOA signing only
# (no Rhinestone / Pimlico) — every tx is signed and paid for by the EOA.
# Keep this `false` in production: the HCA + Warp smart-account flow is the
# product path (gas-sponsored Intents; the payment approval is a gasless
# EIP-2612 permit, so the EOA never sends a transaction). Set `true` only for
# local EOA-only debugging on forks without bundler/relayer infrastructure.
VITE_FF_USE_EOA=false
# Wallet vendor (build time): false → RainbowKit (default, external EOA wallets);
# true → Privy (social / email login). Only the selected vendor's stack is
# bundled (Vite alias). Set VITE_PRIVY_APP_ID when true.
VITE_FF_USE_PRIVY=false
# Backend API base URL — used by backendClient (wallet auto-fund, auth, etc.)
VITE_API_URL=https://app-api.ens.dev
# Privy app id (social login: Google + X). PUBLIC client identifier — it ships
# in the browser bundle; access is gated by the allowed-origins allowlist in the
# Privy dashboard, NOT by hiding this value. The real secrets (Privy app secret,
# Google OAuth client secret) live in the Privy dashboard, never here. If unset,
# the app still boots with auth disabled.
VITE_PRIVY_APP_ID=
