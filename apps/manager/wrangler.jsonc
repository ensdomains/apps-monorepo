{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "manager-app-v4",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "preview_urls": true,
  "observability": {
    "enabled": true
  },

  // Chain used by the orchestrator proxy to resolve the ENS contract
  // allowlist (see src/lib/orchestrator-proxy). Override to "mainnet" in prod.
  "vars": {
    "CHAIN": "sepolia"
  },

  // Rhinestone API key for the orchestrator proxy — injected server-side so it
  // never reaches the client. Set via `wrangler secret put RHINESTONE_API_KEY`.
  "secrets": {
    "required": ["RHINESTONE_API_KEY"]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiterDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiterDO"]
    }
  ]
}
