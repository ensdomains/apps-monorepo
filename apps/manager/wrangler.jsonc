{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "manager-app-v4",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "preview_urls": true,
  "observability": {
    "enabled": true
  },

  // Chain used by the orchestrator proxy to resolve the ENS contract
  // allowlist (see src/lib/orchestrator-proxy). Override to "mainnet" in prod.
  //
  // RHINESTONE_API_KEY is a runtime secret set via
  // `wrangler secret put RHINESTONE_API_KEY` (or the dashboard); it is
  // intentionally not declared here so it never lands in the client bundle.
  "vars": {
    "CHAIN": "sepolia"
  },

  // Per-account sponsorship rate limiting for the orchestrator proxy
  // (see src/lib/orchestrator-proxy/rate-limit.ts). KV needs no migration, so
  // it is compatible with the manager's gradual (`versions upload`) deploys.
  // Create the namespace with `wrangler kv namespace create SPONSOR_RATE_LIMIT_KV`
  // and replace the id below.
  "kv_namespaces": [
    {
      "binding": "SPONSOR_RATE_LIMIT_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
