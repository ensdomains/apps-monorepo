{
  "name": "manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "debug:rhinestone-browser": "vite --config rhinestone-browser-debug/vite.config.ts",
    "dev:inspect": "VITE_INSPECT_XSTATE=true vite dev",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' vite build",
    "preview": "wrangler dev",
    "cf-typegen": "pnpm dlx wrangler types --env-interface Env worker-configuration.gen.d.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretypecheck": "pnpm --filter api-worker run build:types",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n:push": "crowdin upload sources --config crowdin.yml",
    "i18n:pull": "crowdin download --config crowdin.yml",
    "lint": "biome check",
    "lint:fix": "biome check --fix"
  },
