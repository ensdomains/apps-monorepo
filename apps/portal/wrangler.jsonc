{
  "name": "portal-app",
  "compatibility_date": "2025-07-08",
  "main": "src/worker.ts",
  // Used by the OG worker to cap avatar pixel dimensions before satori/resvg
  // decodes them (WEB-1218) — see src/worker/avatar-image.ts.
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/icons/*", "!/client/*"]
  },
  "preview_urls": true,
  // Build with pnpm build:mainnet. Bindings aren't inherited, so `images` repeats.
  "env": {
    "mainnet": {
      "name": "portal-app-mainnet",
      "preview_urls": false,
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
